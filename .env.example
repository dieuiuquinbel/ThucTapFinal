# ==============================================================================
# SmartStudy RAG - Environment Configuration Template (.env.example)
# Sao chép file này thành .env và điền các giá trị phù hợp
# ==============================================================================

# Cấu hình Gửi Email Tự động (SMTP Gmail hoặc máy chủ mail)
# Để gửi email mã OTP đăng ký / quên mật khẩu, hãy điền thông tin bên dưới:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM='"SmartStudy EdTech" <noreply@smartstudy.edu.vn>'

# Cấu hình Bảo mật Token (BẮT BUỘC KHÔNG ĐỂ TRỐNG ĐỂ TRÁNH GIẢ MẠO TOKEN)
# Hãy tạo một chuỗi ngẫu nhiên bí mật và phức tạp cho môi trường của bạn:
JWT_SECRET=thay_doi_chuoi_secret_ngau_nhien_tai_day_123456789
JWT_EXPIRES_DAYS=7

# Chế độ thử nghiệm: Nếu chưa điền SMTP_PASS, mã OTP sẽ tự động in ra màn hình console backend để test tức thì!
ALLOW_DEV_OTP_HINT=true
